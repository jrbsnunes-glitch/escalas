# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# os / editor
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# sqlite
/prisma/*.db
/prisma/*.db-journal

# repertório enviado
/public/repertorio/*
!/public/repertorio/.gitkeep

# anexos das escalas
/public/escalas/*
!/public/escalas/.gitkeep
/data/escalas/*
!/data/escalas/.gitkeep
/data/tmp-uploads/
/public/uploads/escalas/*
!/public/uploads/escalas/.gitkeep

# trava da limpeza automática
/.limpeza-arquivos.json

# artefatos locais de teste
/body*.txt
/cookies-*.txt
